# Copy to .env and adjust. The real .env is git-ignored - never commit it.
# Local development only. Production (Leocloud) gets its password from the
# POSTGRES_PASSWORD GitHub secret, not from this file.

# PostgreSQL (docker-compose.yml)
# Keep the password "mygarden" unless you have a reason to change it: `dotnet run` does
# NOT read this file and uses the password from appsettings.Development.json ("mygarden").
# If you change it, also change ConnectionStrings__Default below and set it in your
# terminal before `dotnet run` (see README -> Running locally).
POSTGRES_DB=mygarden
POSTGRES_USER=mygarden
POSTGRES_PASSWORD=mygarden
# Change if port 5432 is taken (e.g. PostgreSQL installed directly on your PC).
# Then also change the port in ConnectionStrings__Default.
POSTGRES_PORT=5432

# pgAdmin (optional, --profile tools)
PGADMIN_DEFAULT_EMAIL=admin@mygarden.local
PGADMIN_DEFAULT_PASSWORD=admin

# Connection string for `dotnet run`, only needed if you changed the password or port above.
# PowerShell, from the repo root, before `dotnet run`:
#   $env:ConnectionStrings__Default = ((Get-Content .env | Select-String '^ConnectionStrings__Default=').Line -split '=',2)[1]
ConnectionStrings__Default=Host=localhost;Port=5432;Database=mygarden;Username=mygarden;Password=mygarden
