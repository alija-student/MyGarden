# Copy to .env and adjust. The real .env is git-ignored - never commit it.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=mygarden
POSTGRES_USER=mygarden
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# pgAdmin (optional, --profile tools)
PGADMIN_DEFAULT_EMAIL=admin@mygarden.local
PGADMIN_DEFAULT_PASSWORD=change-me

# Used by the API when running outside Visual Studio / dotnet run
# (appsettings.Development.json already points at the default local database)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=mygarden;Username=mygarden;Password=change-me
