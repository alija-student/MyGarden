# Normalize line endings: LF in the repository and working tree
* text=auto eol=lf

# Windows-only files keep CRLF
*.sln   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.dll   binary
*.exe   binary
